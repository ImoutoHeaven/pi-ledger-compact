    "pi",
    "extension",
    "compaction",
    "ledger",
    "context"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImoutoHeaven/pi-ledger-compact.git"
  },
  "bugs": {
    "url": "https://github.com/ImoutoHeaven/pi-ledger-compact/issues"
  },
  "homepage": "https://github.com/ImoutoHeaven/pi-ledger-compact#readme",
  "pi": {
    "extensions": [
      "./src/ledger-context.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
